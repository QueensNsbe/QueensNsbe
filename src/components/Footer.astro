---
const year = new Date().getFullYear();
const socials = [
  { label: 'LinkedIn', href: 'https://www.linkedin.com/company/nsbe-queen-s-university/posts/?feedView=all' },
  { label: 'Instagram', href: 'https://www.instagram.com/nsbe.queens/' },
  { label: 'TikTok', href: 'https://www.tiktok.com/@queens.nsbe' },
];
---
<footer class="site-footer">
  <div class="site-footer-inner">
    <div class="footer-col">
      <p class="footer-heading">NSBE Queen's</p>
      <p class="muted">
        99 University Ave<br />
        Kingston, Ontario K7L 3N6
      </p>
      <p><a href="mailto:nsbe@engsoc.queensu.ca">nsbe@engsoc.queensu.ca</a></p>
    </div>
    <div class="footer-col">
      <p class="footer-heading">Follow Us</p>
      <ul class="footer-social">
        {socials.map((s) => (
          <li><a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a></li>
        ))}
      </ul>
    </div>
  </div>
  <div class="site-footer-bottom">
    <p>&copy; {year} NSBE Queen's University. All rights reserved.</p>
    <p class="muted">National Society of Black Engineers — Queen's Chapter</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    margin-top: 3rem;
    background: #faf8fc;
  }
  .site-footer-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 2.5rem 1.5rem 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem;
    justify-content: space-between;
  }
  .footer-heading {
    font-family: var(--font-display);
    font-weight: 700;
    margin: 0 0 0.5rem;
  }
  .footer-social {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .site-footer-bottom {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 1rem 1.5rem 1.5rem;
    text-align: center;
    font-size: 0.85rem;
    border-top: 1px solid var(--color-border);
  }
  .site-footer-bottom p {
    margin: 0.25rem 0;
  }
</style>
