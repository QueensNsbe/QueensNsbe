---
import { SOCIALS, ICON_PATHS } from '../socials';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-col">
        <h4>Address</h4>
        <p>99 University Ave,<br>Kingston, ON K7L 3N6</p>
      </div>
      <div class="footer-col">
        <h4>Email</h4>
        <a href="mailto:nsbe@engsoc.queensu.ca">nsbe@engsoc.queensu.ca</a>
      </div>
      <div class="footer-col">
        <h4>Follow Us</h4>
        <div class="footer-social">
          <a href={SOCIALS.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn"><svg viewBox="0 0 24 24" fill="currentColor"><path d={ICON_PATHS.linkedin}/></svg></a>
          <a href={SOCIALS.instagram} target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r="1"/></svg></a>
          <a href={SOCIALS.tiktok} target="_blank" rel="noopener" aria-label="TikTok"><svg viewBox="0 0 24 24" fill="currentColor"><path d={ICON_PATHS.tiktok}/></svg></a>
          {SOCIALS.discord && <a href={SOCIALS.discord} target="_blank" rel="noopener" aria-label="Discord"><svg viewBox="0 0 24 24" fill="currentColor"><path d={ICON_PATHS.discord}/></svg></a>}
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; NSBE Queen's University {year}. All Rights Reserved.</p>
    </div>
  </div>
</footer>
