---
// The whole exec team as portrait cards with a name/role bar, grouped by team
// in the order of src/teams.ts (Co-Presidents, Events, Finance, ...). Teams not
// listed there (e.g. IT) follow at the end. Within a team, directors come first.
import { getCollection } from 'astro:content';
import { TEAMS } from '../teams';
import { LI_PATH } from './icons';

const teamOrder = TEAMS.map((t) => (t.department ?? t.name).toLowerCase());
const teamRank = (dept = '') => {
  const i = teamOrder.indexOf(dept.toLowerCase());
  return i === -1 ? teamOrder.length : i;
};
const roleRank = (role: string) => (/president|director/i.test(role) ? 0 : 1);

const all = (await getCollection('exec')).sort(
  (a, b) =>
    teamRank(a.data.department) - teamRank(b.data.department) ||
    (a.data.department ?? '').localeCompare(b.data.department ?? '') ||
    roleRank(a.data.role) - roleRank(b.data.role) ||
    a.data.order - b.data.order ||
    a.data.name.localeCompare(b.data.name)
);
---
<div class="exec-grid reveal-stagger">
  {all.map((e) => (
    <div class="exec-card">
      <img src={e.data.photo} alt={e.data.name} loading="lazy">
      <div class="exec-bar">
        {/* First name on its own line so long surnames never split mid-name. */}
        <h4>
          <span class="first">{e.data.name.split(' ')[0]}</span>
          {e.data.name.includes(' ') && <span class="last">{e.data.name.split(' ').slice(1).join(' ')}</span>}
        </h4>
        <div class="role">{e.data.role}</div>
        {e.data.linkedin && (
          <a class="li-icon" href={e.data.linkedin} target="_blank" rel="noopener" aria-label={`${e.data.name} on LinkedIn`}>
            <svg viewBox="0 0 24 24" fill="currentColor"><path d={LI_PATH}/></svg>
          </a>
        )}
      </div>
    </div>
  ))}
</div>
