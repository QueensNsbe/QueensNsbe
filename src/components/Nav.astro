---
// Site navigation. Active-link highlighting is applied client-side in
// /js/main.js so this stays a static component.
const links = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/mentorship', label: 'Mentorship' },
  { href: '/events', label: 'Events' },
  { href: '/blog', label: 'Blog' },
];
---
<nav class="site-nav">
  <div class="container">
    <a href="/" class="nav-brand">
      <img src="/images/uploads/cropped-NSBE-Logo-Redesigned-2025-Transparent-150x150.png" alt="NSBE Queen's logo">
      <span>NSBE QUEEN'S</span>
    </a>
    <ul class="nav-links" id="navLinks">
      {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      <li><a href="/#join" class="nav-cta">Become a Member</a></li>
    </ul>
    <button class="nav-toggle" id="navToggle" aria-label="Toggle menu"><span></span><span></span><span></span></button>
  </div>
</nav>
