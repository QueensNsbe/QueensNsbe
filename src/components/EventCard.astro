---
interface Props {
  title: string;
  date: Date;
  time?: string;
  location?: string;
  href: string;
}

const { title, date, time, location, href } = Astro.props;
// date-only frontmatter (e.g. "2026-09-15") parses as UTC midnight; formatting
// with timeZone: 'UTC' keeps it from shifting a day back in negative-UTC-offset zones.
const formattedDate = date.toLocaleDateString('en-CA', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---
<a class="card event-card" href={href}>
  <h3>{title}</h3>
  <p class="muted">{formattedDate}{time ? ` · ${time}` : ''}</p>
  {location && <p class="muted">{location}</p>}
</a>

<style>
  .event-card {
    text-decoration: none;
    color: inherit;
    display: block;
  }
  .event-card h3 {
    margin: 0 0 0.35rem;
  }
  .event-card p {
    margin: 0.15rem 0;
  }
</style>
