---
// Co-presidents, as the same portrait cards used for the rest of the team.
import { getCollection } from 'astro:content';
import { LI_PATH } from './icons';

interface Props { style?: string }
const { style } = Astro.props;

const all = (await getCollection('exec')).sort(
  (a, b) => a.data.order - b.data.order || a.data.name.localeCompare(b.data.name)
);
const leads = all.filter((e) => /president/i.test(e.data.role));
---
<div class="exec-grid exec-lead-grid reveal-stagger" style={style}>
  {leads.map((e) => (
    <div class="exec-card">
      <img src={e.data.photo} alt={e.data.name} loading="lazy">
      <div class="exec-bar">
        <h4>
          <span class="first">{e.data.name.split(' ')[0]}</span>
          {e.data.name.includes(' ') && <span class="last">{e.data.name.split(' ').slice(1).join(' ')}</span>}
        </h4>
        <div class="role">{e.data.role}</div>
        {e.data.linkedin && (
          <a class="li-icon" href={e.data.linkedin} target="_blank" rel="noopener" aria-label={`${e.data.name} on LinkedIn`}>
            <svg viewBox="0 0 24 24" fill="currentColor"><path d={LI_PATH}/></svg>
          </a>
        )}
      </div>
    </div>
  ))}
</div>
