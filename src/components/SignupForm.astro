---
// Branded signup form. /js/main.js submits it to the Loops newsletter-form
// endpoint below with fetch(), so subscribers land in the Loops audience.
interface Props {
  variant?: 'page' | 'banner';
}
const { variant = 'page' } = Astro.props;
const LOOPS_ACTION = 'https://app.loops.so/api/newsletter-form/cmtkay2t100bs0jyy522vnhah';
---
<form
  class={`signup-form signup-form--${variant}`}
  action={LOOPS_ACTION}
  method="post"
  data-signup-form
>
  <div class="signup-fields">
    <label class="signup-field">
      <span>Name</span>
      <input type="text" name="firstName" autocomplete="name" placeholder="Your name" required>
    </label>
    <label class="signup-field">
      <span>Email</span>
      <input type="email" name="email" autocomplete="email" placeholder="you@queensu.ca" required>
    </label>
  </div>
  <button type="submit" class="btn btn-light signup-submit">Subscribe</button>
  <p class="signup-status" data-signup-status role="status" aria-live="polite"></p>
</form>
