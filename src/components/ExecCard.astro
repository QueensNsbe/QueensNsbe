---
interface Props {
  name: string;
  role: string;
  department?: string;
  photo?: string;
  email?: string;
  linkedin?: string;
}

const { name, role, department, photo, email, linkedin } = Astro.props;
---
<div class="card exec-card">
  {photo && <img src={photo} alt={name} />}
  <h3>{name}</h3>
  <p class="muted">{role}{department ? ` · ${department}` : ''}</p>
  <p class="exec-links">
    {email && <a href={`mailto:${email}`}>Email</a>}
    {email && linkedin && ' · '}
    {linkedin && <a href={linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>}
  </p>
</div>

<style>
  .exec-card img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--radius);
    margin-bottom: 0.75rem;
  }
  .exec-card h3 {
    margin: 0 0 0.15rem;
  }
  .exec-card p {
    margin: 0.15rem 0;
  }
  .exec-links {
    font-size: 0.9rem;
  }
</style>
