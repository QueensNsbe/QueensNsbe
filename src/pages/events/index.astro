---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventCard from '../../components/EventCard.astro';
import { getCollection } from 'astro:content';

const allEvents = (await getCollection('events')).sort(
  (a, b) => a.data.date.valueOf() - b.data.date.valueOf()
);
const now = new Date();
const upcoming = allEvents.filter((e) => e.data.date >= now);
const past = allEvents.filter((e) => e.data.date < now).reverse();

const galleryImages = [
  'https://www.engsoc.queensu.ca/nsbe/wp-content/uploads/2025/09/IMG_9716-1024x683.jpg',
  'https://www.engsoc.queensu.ca/nsbe/wp-content/uploads/2025/08/Black-Engineer-Mixer-09-1-768x512.jpg',
  'https://www.engsoc.queensu.ca/nsbe/wp-content/uploads/2025/09/IMG_9731-scaled.jpg',
  'https://www.engsoc.queensu.ca/nsbe/wp-content/uploads/2025/09/IMG_9834-1024x683.jpg',
  'https://www.engsoc.queensu.ca/nsbe/wp-content/uploads/2025/09/IMG_9730-scaled.jpg',
  'https://www.engsoc.queensu.ca/nsbe/wp-content/uploads/2025/08/VAL2415-1-scaled.jpg',
];
---
<BaseLayout title="Events" description="Upcoming and past NSBE Queen's events.">
  <p class="kicker">What's Happening</p>
  <h1>Events</h1>
  <p class="muted">
    Events designed to connect, empower, and inspire — from study labs and
    career panels to socials and conferences.
  </p>

  <h2>Upcoming</h2>
  {upcoming.length === 0 && <p class="muted">No upcoming events yet — check back soon, or <a href="/contact">join our email list</a> for updates.</p>}
  <div class="card-grid">
    {upcoming.map((event) => (
      <EventCard
        title={event.data.title}
        date={event.data.date}
        time={event.data.time}
        location={event.data.location}
        image={event.data.image}
        href={`/events/${event.id}`}
      />
    ))}
  </div>

  {past.length > 0 && (
    <>
      <h2>Past Events</h2>
      <div class="card-grid">
        {past.map((event) => (
          <EventCard
            title={event.data.title}
            date={event.data.date}
            time={event.data.time}
            location={event.data.location}
            image={event.data.image}
            href={`/events/${event.id}`}
          />
        ))}
      </div>
    </>
  )}

  <h2>Community In Motion</h2>
  <p class="muted">A look back at the socials, conferences, and gatherings that make NSBE Queen's a home away from home.</p>
  <div class="gallery-grid">
    {galleryImages.map((src) => (
      <a href={src} target="_blank" rel="noopener noreferrer"><img src={src} alt="NSBE Queen's event moment" loading="lazy" /></a>
    ))}
  </div>
</BaseLayout>
