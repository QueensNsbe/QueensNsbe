---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const sorted = (await getCollection('events')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

// "Community in Motion" collage. A `tall` tile spans two rows, so its cell is
// portrait — only mark portrait photos tall, or `object-fit: cover` crops the
// middle out of a landscape shot and cuts people's heads off.
const gallery = [
  { src: '/images/uploads/IMG_9716-1024x683.jpg', alt: "NSBE Queen's members at a chapter event" },
  { src: '/images/uploads/IMG_9682-scaled-e1758409214405-758x1024.jpg', alt: "NSBE Queen's event moment", tall: true },
  { src: '/images/uploads/Black-Engineer-Mixer-09-1-768x512.jpg', alt: 'Black Engineer Mixer' },
  { src: '/images/uploads/IMG_9731-scaled.jpg', alt: "NSBE Queen's social" },
  { src: '/images/uploads/IMG_9834-1024x683.jpg', alt: "NSBE Queen's mentorship event" },
  { src: '/images/uploads/IMG_9730-scaled.jpg', alt: "NSBE Queen's members connecting" },
  { src: '/images/uploads/VAL2415-1-scaled.jpg', alt: "NSBE Queen's community event" },
  { src: '/images/uploads/hunt-conference-01.jpg', alt: "NSBE Queen's members at the HUNT Conference" },
  { src: '/images/uploads/IMG_5515-1-768x1024.jpg', alt: "NSBE Queen's members walking on campus", tall: true },
  { src: '/images/uploads/internship-panel-01.jpg', alt: "NSBE Queen's members at the Internship Panel" },
  { src: '/images/uploads/internship-panel-04.jpg', alt: 'A past intern speaking during the panel discussion' },
  { src: '/images/uploads/IMG_9703-2048x1365.jpg', alt: "NSBE Queen's group photo" },
  { src: '/images/uploads/IMG_9721-1024x683.jpg', alt: "NSBE Queen's members at a chapter social" },
  { src: '/images/uploads/bsse-group-railing.jpg', alt: "NSBE Queen's members together on campus" },
  { src: '/images/uploads/black-history-month-social-2026.jpg', alt: 'Black History Month social' },
  { src: '/images/uploads/IMG_9728-1-1024x741.jpg', alt: "NSBE Queen's mentorship session" },
  { src: '/images/uploads/VAL2415-2-1024x683.jpg', alt: "NSBE Queen's members at a chapter event" },
  { src: '/images/uploads/IMG_7027-768x576.jpg', alt: "NSBE Queen's members" },
];

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

// Feeds the calendar widget in /js/main.js (read from #calendar-data).
const calendarData = sorted.map((e) => ({
  date: e.data.date.toISOString().slice(0, 10),
  title: e.data.title,
  href: `/events/${e.id}`,
  category: e.data.category,
}));
---
<BaseLayout title="Events" description="Upcoming and past events from NSBE Queen's University, socials, conferences, panels, and study sessions.">
<!-- ============ PAGE HERO ============ -->
<header class="page-hero">
  <div class="page-hero-bg" style="background-image:url('/images/uploads/black-history-month-social-2026.jpg'); background-position: center 78%;"></div>
  <div class="page-hero-scrim"></div>
  <div class="container page-hero-content">
    <h1>What's Happening at NSBE</h1>
    <p>Events designed to connect, empower, and inspire.</p>
  </div>
</header>

<!-- ============ RECENT EVENTS ============ -->
<section class="section">
  <div class="container">
    <div class="section-head reveal">
      <p class="kicker">Recent Events</p>
      <h2>Highlights From 2025&ndash;2026</h2>
    </div>
    <div class="event-grid reveal-stagger">
      {sorted.map((e) => (
        <a class={`event-card event-card--${e.data.category}`} href={`/events/${e.id}`}>
          {e.data.image && <div class="event-img"><img src={e.data.image} alt={e.data.title} loading="lazy"></div>}
          <div class="event-body">
            <div class="event-date">
              {fmtDate(e.data.date)}
              {e.data.category === 'mentorship' && <span class="event-tag event-tag--mentorship">Mentorship</span>}
            </div>
            <h3>{e.data.title}</h3>
            {e.data.location && <p class="event-meta">{e.data.location}{e.data.time ? ` · ${e.data.time}` : ''}</p>}
          </div>
        </a>
      ))}
    </div>
    {sorted.length === 0 && <p class="text-center">No events logged yet, check back soon.</p>}
  </div>
</section>

<!-- ============ CALENDAR ============ -->
<section class="section section-alt">
  <div class="container">
    <div class="section-head center reveal">
      <p class="kicker" style="justify-content:center;">Calendar</p>
      <h2>NSBE Queen's Events Calendar</h2>
      <p>Browse by month to see what's on. Days with a dot have a logged event. Click one, or pick from the list, to see details.</p>
      <div class="cal-legend">
        <span><span class="cal-legend-dot cal-legend-dot--general"></span>General Event</span>
        <span><span class="cal-legend-dot cal-legend-dot--mentorship"></span>Mentorship</span>
      </div>
    </div>
    <div class="cal-wrap reveal">
      <div class="nsbe-calendar">
        <div class="cal-head">
          <button class="cal-nav" id="calPrev" aria-label="Previous month"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg></button>
          <div>
            <div class="cal-title" id="calTitle">Month Year</div>
            <button class="cal-today-btn" id="calToday">Jump to today</button>
          </div>
          <button class="cal-nav" id="calNext" aria-label="Next month"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg></button>
        </div>
        <div class="cal-weekdays"><span>Sun</span><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span></div>
        <div class="cal-grid" id="calGrid"></div>
      </div>
      <div class="cal-side">
        <h3>Logged Events</h3>
        <ul class="cal-event-list" id="calEventList"></ul>
        <a href="/join" class="btn btn-ink btn-sm">Get Notified of New Events</a>
      </div>
    </div>
  </div>
</section>

<!-- ============ GALLERY ============ -->
<section class="section">
  <div class="container">
    <div class="section-head center">
      <p class="kicker" style="justify-content:center;">Moments</p>
      <h2>Community in Motion</h2>
      <p>A look back at the socials, conferences, and gatherings that make NSBE Queen's a home away from home.</p>
    </div>
    <div class="gallery-grid reveal-stagger">
      {gallery.map((g) => (
        <a href={g.src} target="_blank" rel="noopener" class={g.tall ? 'tall' : undefined}>
          <img src={g.src} alt={g.alt} loading="lazy">
        </a>
      ))}
    </div>
  </div>
</section>

<!-- ============ FOOTER ============ -->
<script type="application/json" id="calendar-data" set:html={JSON.stringify(calendarData)} is:inline></script>
</BaseLayout>
