---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventCard from '../../components/EventCard.astro';
import { getCollection } from 'astro:content';

const allEvents = (await getCollection('events')).sort(
  (a, b) => a.data.date.valueOf() - b.data.date.valueOf()
);
const now = new Date();
const upcoming = allEvents.filter((e) => e.data.date >= now);
const past = allEvents.filter((e) => e.data.date < now).reverse();
---
<BaseLayout title="Events" description="Upcoming and past NSBE Queen's events.">
  <h1>Events</h1>

  <h2>Upcoming</h2>
  {upcoming.length === 0 && <p class="muted">No upcoming events yet — check back soon.</p>}
  <div class="card-grid">
    {upcoming.map((event) => (
      <EventCard
        title={event.data.title}
        date={event.data.date}
        time={event.data.time}
        location={event.data.location}
        href={`/events/${event.id}`}
      />
    ))}
  </div>

  {past.length > 0 && (
    <>
      <h2>Past Events</h2>
      <div class="card-grid">
        {past.map((event) => (
          <EventCard
            title={event.data.title}
            date={event.data.date}
            time={event.data.time}
            location={event.data.location}
            href={`/events/${event.id}`}
          />
        ))}
      </div>
    </>
  )}
</BaseLayout>
