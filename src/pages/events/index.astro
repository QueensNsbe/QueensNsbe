---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const sorted = (await getCollection('events')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

// Feeds the calendar widget in /js/main.js (read from #calendar-data).
const calendarData = sorted.map((e) => ({
  date: e.data.date.toISOString().slice(0, 10),
  title: e.data.title,
  href: `/events/${e.id}`,
}));
---
<BaseLayout title="Events" description="Upcoming and past events from NSBE Queen's University — socials, conferences, panels, and study sessions.">
<!-- ============ PAGE HERO ============ -->
<header class="page-hero">
  <div class="page-hero-bg" style="background-image:url('/images/uploads/IMG_5515-1-768x1024.jpg'); background-position: center 25%;"></div>
  <div class="page-hero-scrim"></div>
  <div class="container page-hero-content">
    <div class="breadcrumb"><a href="/">Home</a><span>/</span>Events</div>
    <h1>What's Happening at NSBE</h1>
    <p>Events designed to connect, empower, and inspire. From study labs and career panels to socials and conferences, each event is designed to help you grow academically, professionally, and personally.</p>
  </div>
</header>

<!-- ============ RECENT EVENTS ============ -->
<section class="section">
  <div class="container">
    <div class="section-head reveal">
      <p class="kicker">Recent Events</p>
      <h2>Highlights From This Year</h2>
    </div>
    <div class="event-grid reveal-stagger">
      {sorted.map((e) => (
        <a class="event-card" href={`/events/${e.id}`}>
          {e.data.image && <div class="event-img"><img src={e.data.image} alt={e.data.title} loading="lazy"></div>}
          <div class="event-body">
            <div class="event-date">{fmtDate(e.data.date)}</div>
            <h3>{e.data.title}</h3>
            {e.data.location && <p class="event-meta">{e.data.location}{e.data.time ? ` · ${e.data.time}` : ''}</p>}
          </div>
        </a>
      ))}
    </div>
    {sorted.length === 0 && <p class="text-center">No events logged yet — check back soon.</p>}
  </div>
</section>

<!-- ============ CALENDAR ============ -->
<section class="section section-alt">
  <div class="container">
    <div class="section-head center reveal">
      <p class="kicker" style="justify-content:center;">Calendar</p>
      <h2>NSBE Queen's Events Calendar</h2>
      <p>Browse by month to see what's on. Days with a gold dot have a logged event — click one, or pick from the list, to see details.</p>
    </div>
    <div class="cal-wrap reveal">
      <div class="nsbe-calendar">
        <div class="cal-head">
          <button class="cal-nav" id="calPrev" aria-label="Previous month"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg></button>
          <div>
            <div class="cal-title" id="calTitle">Month Year</div>
            <button class="cal-today-btn" id="calToday">Jump to today</button>
          </div>
          <button class="cal-nav" id="calNext" aria-label="Next month"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg></button>
        </div>
        <div class="cal-weekdays"><span>Sun</span><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span></div>
        <div class="cal-grid" id="calGrid"></div>
      </div>
      <div class="cal-side">
        <h3>Logged Events</h3>
        <ul class="cal-event-list" id="calEventList"></ul>
        <a href="https://preview.mailerlite.io/forms/2022036/176152616540047196/share" target="_blank" rel="noopener" class="btn btn-gold btn-sm">Get Notified of New Events</a>
      </div>
    </div>
  </div>
</section>

<!-- ============ GALLERY ============ -->
<section class="section">
  <div class="container">
    <div class="section-head center">
      <p class="kicker" style="justify-content:center;">Moments</p>
      <h2>Community In Motion</h2>
      <p>A look back at the socials, conferences, and gatherings that make NSBE Queen's a home away from home.</p>
    </div>
    <div class="gallery-grid reveal-stagger">
      <a href="/images/uploads/IMG_9716-1024x683.jpg" target="_blank" rel="noopener" class="tall"><img src="/images/uploads/IMG_9716-1024x683.jpg" alt="NSBE Queen's event moment" loading="lazy"></a>
      <a href="/images/uploads/IMG_9682-scaled-e1758409214405-758x1024.jpg" target="_blank" rel="noopener" class="tall"><img src="/images/uploads/IMG_9682-scaled-e1758409214405-758x1024.jpg" alt="NSBE Queen's event moment" loading="lazy"></a>
      <a href="/images/uploads/Black-Engineer-Mixer-09-1-768x512.jpg" target="_blank" rel="noopener"><img src="/images/uploads/Black-Engineer-Mixer-09-1-768x512.jpg" alt="Black Engineer Mixer" loading="lazy"></a>
      <a href="/images/uploads/IMG_9731-scaled.jpg" target="_blank" rel="noopener"><img src="/images/uploads/IMG_9731-scaled.jpg" alt="NSBE Queen's event moment" loading="lazy"></a>
      <a href="/images/uploads/IMG_9834-1024x683.jpg" target="_blank" rel="noopener"><img src="/images/uploads/IMG_9834-1024x683.jpg" alt="NSBE Queen's mentorship event" loading="lazy"></a>
      <a href="/images/uploads/IMG_9730-scaled.jpg" target="_blank" rel="noopener" class="tall"><img src="/images/uploads/IMG_9730-scaled.jpg" alt="NSBE Queen's social" loading="lazy"></a>
      <a href="/images/uploads/VAL2415-1-scaled.jpg" target="_blank" rel="noopener"><img src="/images/uploads/VAL2415-1-scaled.jpg" alt="NSBE Queen's event moment" loading="lazy"></a>
    </div>
  </div>
</section>

<!-- ============ STAY UPDATED CTA ============ -->
<section class="section">
  <div class="cta-section reveal">
    <h2>Never Miss an Event</h2>
    <p>New events are added throughout the year — join our email list and Discord community to get the full calendar, RSVP links, and reminders straight to your inbox.</p>
    <div class="cta-actions">
      <a href="https://preview.mailerlite.io/forms/2022036/176152616540047196/share" target="_blank" rel="noopener" class="btn btn-gold">Join Our Community <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg></a>
      <a href="https://www.instagram.com/nsbe.queens/" target="_blank" rel="noopener" class="btn btn-outline">Follow on Instagram</a>
    </div>
  </div>
</section>

<!-- ============ FOOTER ============ -->
<script type="application/json" id="calendar-data" set:html={JSON.stringify(calendarData)} is:inline></script>
</BaseLayout>
