---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map((event) => ({ params: { slug: event.id }, props: { event } }));
}

const { event } = Astro.props;
const { Content } = await render(event);
const fmt = (d: Date) => d.toLocaleDateString('en-US', {
  weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC',
});
const gallery = event.data.gallery ?? [];
const formatted = fmt(event.data.date) + (event.data.endDate ? ` – ${fmt(event.data.endDate)}` : '');
---
<BaseLayout title={event.data.title} description={event.data.description}>
  <header class="page-hero page-hero-short">
    {event.data.image && <div class="page-hero-bg" style={`background-image:url('${event.data.image}');`}></div>}
    <div class="page-hero-scrim"></div>
    <div class="container page-hero-content">
      <h1>{event.data.title}</h1>
      <p>{formatted}{event.data.time ? ` · ${event.data.time}` : ''}{event.data.location ? ` · ${event.data.location}` : ''}</p>
    </div>
  </header>

  <section class="section">
    <div class="container narrow">
      <article class="prose reveal"><Content /></article>
      {gallery.length > 0 && (
        <section class="event-photos reveal" aria-label={`${event.data.title} photos`}>
          <div class={`photo-collage photo-collage--${Math.min(gallery.length, 3)}`}>
            {gallery.map((shot, i) => (
              <button type="button" class="photo-tile" data-index={i} aria-label={`Open photo ${i + 1} of ${gallery.length}`}>
                <img src={shot.image} alt={shot.alt ?? `${event.data.title} photo ${i + 1}`} loading={i === 0 ? 'eager' : 'lazy'}>
              </button>
            ))}
          </div>
        </section>
      )}

      <div class="cta-actions" style="margin-top:40px;">
        {event.data.rsvpLink && <a href={event.data.rsvpLink} target="_blank" rel="noopener" class="btn btn-gold">RSVP</a>}
        <a href="/events" class="btn btn-purple">&larr; All Events</a>
      </div>
    </div>
  </section>

  {gallery.length > 0 && (
    <div class="lightbox" id="lightbox" hidden role="dialog" aria-modal="true" aria-label={`${event.data.title} photos`}>
      <button type="button" class="lb-close" aria-label="Close">&times;</button>
      <button type="button" class="lb-nav lb-prev" aria-label="Previous photo"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg></button>
      <figure class="lb-figure">
        <img class="lb-img" src="" alt="">
        <figcaption class="lb-count"></figcaption>
      </figure>
      <button type="button" class="lb-nav lb-next" aria-label="Next photo"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg></button>
      <script type="application/json" id="lb-data" set:html={JSON.stringify(gallery.map((g, i) => ({ src: g.image, alt: g.alt ?? `${event.data.title} photo ${i + 1}` })))}></script>
    </div>
  )}
</BaseLayout>

<script>
  const box = document.getElementById('lightbox');
  if (box) {
    const shots: { src: string; alt: string }[] = JSON.parse(document.getElementById('lb-data')!.textContent || '[]');
    const img = box.querySelector<HTMLImageElement>('.lb-img')!;
    const count = box.querySelector<HTMLElement>('.lb-count')!;
    let idx = 0;
    let opener: HTMLElement | null = null;
    const show = (i: number) => {
      idx = (i + shots.length) % shots.length;
      img.src = shots[idx].src;
      img.alt = shots[idx].alt;
      count.textContent = `${idx + 1} / ${shots.length}`;
    };
    const open = (i: number, from: HTMLElement) => {
      opener = from;
      show(i);
      box.hidden = false;
      document.body.style.overflow = 'hidden';
      box.querySelector<HTMLButtonElement>('.lb-close')!.focus();
    };
    const close = () => {
      box.hidden = true;
      document.body.style.overflow = '';
      opener?.focus();
    };
    const single = shots.length < 2;
    box.querySelectorAll<HTMLElement>('.lb-nav').forEach((b) => (b.hidden = single));
    document.querySelectorAll<HTMLElement>('.photo-tile').forEach((t) =>
      t.addEventListener('click', () => open(Number(t.dataset.index), t))
    );
    box.querySelector('.lb-close')!.addEventListener('click', close);
    box.querySelector('.lb-prev')!.addEventListener('click', () => show(idx - 1));
    box.querySelector('.lb-next')!.addEventListener('click', () => show(idx + 1));
    box.addEventListener('click', (e) => { if (e.target === box) close(); });
    document.addEventListener('keydown', (e) => {
      if (box.hidden) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowLeft' && !single) show(idx - 1);
      else if (e.key === 'ArrowRight' && !single) show(idx + 1);
    });
    // Swipe on phones.
    let x0: number | null = null;
    box.addEventListener('touchstart', (e) => (x0 = e.touches[0].clientX), { passive: true });
    box.addEventListener('touchend', (e) => {
      if (x0 === null || single) return;
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 40) show(idx + (dx < 0 ? 1 : -1));
      x0 = null;
    });
  }
</script>
