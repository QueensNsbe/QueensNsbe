---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { ARROW } from '../components/icons';
import { EVENT_CATEGORIES } from '../eventCategories';
import { SOCIALS, ICON_PATHS } from '../socials';

const execAll = await getCollection('exec');
const testimonials = (await getCollection('testimonials')).sort(
  (a, b) => a.data.order - b.data.order
);

const allEvents = (await getCollection('events')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const now = new Date();
const upcoming = allEvents.filter((e) => (e.data.endDate ?? e.data.date) >= now).reverse();
const featured = upcoming.length > 0 ? upcoming.slice(0, 3) : allEvents.slice(0, 3);
const eventsHeading = upcoming.length > 0 ? 'Upcoming Events' : 'Recent Events';

// Sponsor spotlight: the most recent event that lists sponsors in the CMS.
const spotlightEvent = allEvents.find((e) => (e.data.sponsors ?? []).length > 0);
const spotlightSponsors = spotlightEvent?.data.sponsors ?? [];
const spotlightNames = spotlightSponsors.map((s) => s.name).join(' & ');

const JOIN_URL = '/join';
const IG_URL = SOCIALS.instagram;

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

const stats = [
  { count: 16000, suffix: '+', label: 'Members Worldwide', icon: 'people' },
  { count: 500, suffix: '+', label: 'Chapters Globally', icon: 'globe' },
  { count: 1975, suffix: '', label: 'NSBE Founded (Est.)', icon: 'star' },
  // Set by hand: the full 2026–2027 exec is 19, including members who don't
  // have a card on the site yet (e.g. Reme Oko-oboh). Update each new year.
  { count: Math.max(execAll.length, 19), suffix: '', label: "Queen's Exec Leaders", icon: 'cap' },
];

// Managed in the CMS under "Social Videos" so exec can swap in recent posts.
const socialTiles = (await getCollection('socialPosts')).sort(
  (a, b) => a.data.order - b.data.order
);

const ICONS: Record<string, string> = {
  people: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  globe: '<circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15 15 0 0 1 0 20a15 15 0 0 1 0-20z"/>',
  cap: '<path d="M22 10 12 5 2 10l10 5 10-5Z"/><path d="M6 12v5c0 1.5 3 3 6 3s6-1.5 6-3v-5"/>',
  briefcase: '<rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>',
};
const STAR = '<path d="M12 2l2.9 6.4L22 9l-5 5 1.2 7L12 17.8 5.8 21 7 14 2 9l7.1-.6z"/>';
---
<BaseLayout title="Home">
  <!-- ============ HERO ============ -->
  <header class="hero">
    <div class="hero-bg" style="background-image:url('/images/uploads/1B6A7463.jpg');"></div>
    <div class="hero-scrim"></div>
    <div class="container hero-content">
      <p class="kicker on-dark">Queen's University Chapter</p>
      <h1><span class="h1-lead">Welcome to</span> <em>NSBE Queen's</em></h1>
      <p class="lead">The National Society of Black Engineers, Queen's Chapter. We support academic success and celebrate Black excellence on campus through events, mentorship, and leadership opportunities.</p>
      <div class="hero-actions">
        <a href={JOIN_URL} class="btn btn-outline">Become a Member <Fragment set:html={ARROW} /></a>
      </div>
    </div>
  </header>

  <!-- ============ MARQUEE ============ -->
  <div class="marquee">
    {/* Two identical halves, each repeating the values enough times to be wider
        than any screen, so the -50% loop never shows a gap. */}
    <div class="marquee-track">
      {[0, 1].map(() => (
        <span>{Array.from({ length: 4 }).map(() => (
          <>Excellence<span></span>Exposure<span></span>Community<span></span>Empathy<span></span>Leadership<span></span></>
        ))}</span>
      ))}
    </div>
  </div>

  <!-- ============ STATS ============ -->
  <section class="stats">
    <div class="container stats-grid">
      {stats.map((s) => (
        <div class="stat-tile reveal">
          <div class="stat-icon-badge">
            {s.icon === 'star'
              ? <svg viewBox="0 0 24 24" fill="currentColor" set:html={STAR} />
              : <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[s.icon]} />}
          </div>
          <div class="stat-num"><span data-count={s.count}>0</span>{s.suffix && <span class="suffix">{s.suffix}</span>}</div>
          <div class="stat-label">{s.label}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- ============ SPONSOR SPOTLIGHT ============ -->
  {spotlightEvent && (
    <section class="sponsor-spotlight" aria-labelledby="spotlight-title">
      <div class="container sponsor-spotlight-inner reveal">
        <div class="sponsor-spotlight-copy">
          <p class="kicker on-dark">Sponsor Spotlight</p>
          <h2 id="spotlight-title">Thank you to our sponsor{spotlightSponsors.length > 1 ? 's' : ''}</h2>
          <p>
            Our <a href={`/events/${spotlightEvent.id}`}>{spotlightEvent.data.title}</a> was made possible
            by the {spotlightNames}. We're grateful for their support of engineering students at Queen's.
          </p>
          <div class="sponsor-spotlight-actions">
            <a href={`/events/${spotlightEvent.id}`} class="btn btn-gold">See the Event <Fragment set:html={ARROW} /></a>
            <a href="/sponsorship" class="btn btn-outline">Become a Sponsor</a>
          </div>
        </div>
        <div class="sponsor-spotlight-logos">
          {spotlightSponsors.map((s) => {
            const Tag = s.url ? 'a' : 'div';
            return (
              <Tag href={s.url} target={s.url ? '_blank' : undefined} rel={s.url ? 'noopener' : undefined} class="sponsor-spotlight-logo">
                <img src={s.logo} alt={s.name} onerror="this.hidden=true;this.nextElementSibling.hidden=false">
                <span class="sponsor-spotlight-name" hidden>{s.name}</span>
              </Tag>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- ============ WHO WE ARE (+ member voices) ============ -->
  <section class="section">
    <div class="container split">
      <div class="split-body reveal">
        <p class="kicker">Who We Are</p>
        <h2>Building culturally responsible engineers.</h2>
        <p>The Queen's University National Society of Black Engineers (NSBE) chapter is one of the many chapters of the North American NSBE organization. Our mission is to increase the number of culturally responsible black engineers who excel academically, succeed professionally and positively impact the community.</p>
        <p>Through our events, mentorship, and leadership opportunities, we support academic success and celebrate Black excellence on campus.</p>
        <a href="/about" class="btn btn-purple">Learn More <Fragment set:html={ARROW} /></a>
      </div>
      <div class="split-media reveal">
        <img src="/images/uploads/IMG_9730-scaled.jpg" alt="NSBE Queen's members connecting at a chapter social" loading="lazy">
        <div class="frame-accent"></div>
      </div>
    </div>

    {testimonials.length > 0 && (
      <div class="container quote-strip reveal">
        <p class="quote-strip-head">In Their Words</p>
        <div class="quote-grid quote-grid--swipe">
          {testimonials.slice(0, 3).map((t) => (
            <blockquote class="quote-card">
              <p class="quote">&ldquo;{t.data.quote}&rdquo;</p>
              <div class="attrib">
                {t.data.photo && <img src={t.data.photo} alt={t.data.name} loading="lazy">}
                <div>
                  <div class="name">{t.data.name}</div>
                  {t.data.role && <div class="role">{t.data.role}</div>}
                </div>
              </div>
            </blockquote>
          ))}
        </div>
      </div>
    )}
  </section>

  <!-- ============ MENTORSHIP TEASER ============ -->
  <section class="section section-ink">
    <div class="container split reverse">
      <div class="split-body reveal">
        <p class="kicker on-dark">Mentorship</p>
        <h2>Mentorship That Matters</h2>
        <p>Our mentorship program connects Black engineering students with upper-year students and graduates who understand their journey. Through guidance, support, and shared experiences, we help members navigate academic challenges, career opportunities, and personal growth.</p>
        <p>Mentorship at NSBE is about building lasting connections that inspire confidence, success, and a commitment to giving back.</p>
        <a href="/mentorship" class="btn btn-outline">Learn More <Fragment set:html={ARROW} /></a>
      </div>
      <div class="split-media reveal">
        <img src="/images/uploads/IMG_9834-1024x683.jpg" alt="NSBE Queen's mentorship program members" loading="lazy">
        <div class="frame-accent"></div>
      </div>
    </div>
  </section>

  <!-- ============ OPEN INTERNSHIPS (from the chapter Discord) ============ -->
  <section class="section section-rule internships" id="internships" hidden>
    <div class="container">
      <div class="section-head center">
        <p class="kicker" style="justify-content:center;">Career Board</p>
        <h2>Open Internships</h2>
        <p>Fresh opportunities shared by our presidents in the NSBE Queen's Discord. Apply early, since many close fast.</p>
      </div>
      <p class="internships-sample" hidden>Sample postings. Real ones appear once the Discord bot is connected.</p>
      <div class="internship-grid"></div>
      {SOCIALS.discord && (
        <a class="internships-discord" href={SOCIALS.discord} target="_blank" rel="noopener">
          <span class="internships-discord-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d={ICON_PATHS.discord} /></svg>
          </span>
          <span class="internships-discord-copy">
            <strong>See all open internships</strong>
            <span>These are the 3 newest. Every posting, plus deadlines and tips, is in <b>#job-oppurtunities</b> on our Discord.</span>
          </span>
          <span class="btn btn-gold internships-discord-btn">Join Our Discord <Fragment set:html={ARROW} /></span>
        </a>
      )}
    </div>
  </section>
  <script>
    const section = document.getElementById('internships');
    const grid = section?.querySelector('.internship-grid');

    function ago(iso: string) {
      const h = Math.round((Date.now() - Date.parse(iso)) / 3_600_000);
      if (h < 1) return 'Just posted';
      if (h < 24) return `${h}h ago`;
      const d = Math.round(h / 24);
      return d === 1 ? 'Yesterday' : `${d} days ago`;
    }

    function el(tag: string, cls: string, text?: string) {
      const n = document.createElement(tag);
      n.className = cls;
      if (text) n.textContent = text;
      return n;
    }

    fetch('/api/internships.json')
      .then((r) => (r.ok ? r.json() : { postings: [] }))
      .then(({ postings, sample }) => {
        if (!section || !grid || !postings?.length) return;
        // Only the 3 newest show here; the Discord box below links to the rest.
        for (const p of postings.slice(0, 3)) {
          const card = el('a', 'internship-card') as HTMLAnchorElement;
          card.href = p.link;
          card.target = '_blank';
          card.rel = 'noopener noreferrer';
          const meta = el('div', 'internship-meta');
          meta.append(el('span', 'internship-posted', ago(p.postedAt)));
          if (p.deadline) meta.append(el('span', 'internship-deadline', `Due ${p.deadline}`));
          if (p.category) card.append(el('p', 'internship-category', p.category));
          card.append(meta, el('h3', '', p.title));
          const facts = el('ul', 'internship-facts');
          for (const [label, value] of [['Location', p.location], ['Pay', p.pay], ['Term', p.term]]) {
            if (!value) continue;
            const li = el('li', '');
            li.append(el('span', 'internship-fact-label', label), document.createTextNode(value));
            facts.append(li);
          }
          if (facts.childElementCount) card.append(facts);
          if (p.details) card.append(el('p', 'internship-details', p.details));
          const foot = el('div', 'internship-foot');
          foot.append(el('span', 'internship-site', p.site), el('span', 'internship-apply', 'Apply →'));
          card.append(foot);
          grid.append(card);
        }
        if (sample) section.querySelector<HTMLElement>('.internships-sample')!.hidden = false;
        section.hidden = false;
      })
      .catch(() => {});
  </script>

  <!-- ============ EVENTS TEASER ============ -->
  <section class="section">
    <div class="container">
      <div class="section-head center">
        <p class="kicker" style="justify-content:center;">What's Happening</p>
        <h2>{eventsHeading}</h2>
        <p>From study labs and career panels to socials and conferences, these are spaces to connect, learn, and celebrate Black excellence in STEM.</p>
      </div>
      {featured.length === 0 && <p class="text-center">No events yet. Check back soon.</p>}
      <div class="event-grid event-grid--swipe reveal-stagger">
        {featured.map((e) => (
          <a class={`event-card event-card--${e.data.category}`} href={`/events/${e.id}`}>
            <div class="event-body">
              <div class="event-date">
                {fmtDate(e.data.date)}{e.data.endDate && ` – ${fmtDate(e.data.endDate)}`}
                <span class={`event-tag event-tag--${e.data.category}`}>{EVENT_CATEGORIES[e.data.category]}</span>
              </div>
              <h3>{e.data.title}</h3>
              {e.data.location && <p>{e.data.location}</p>}
            </div>
          </a>
        ))}
      </div>
      <div class="text-center reveal" style="margin-top:40px;">
        <a href="/events" class="btn btn-dark-outline">View All Events <Fragment set:html={ARROW} /></a>
      </div>

      <div class="social-strip reveal chapter-motion">
      <div>
        <p class="kicker">Follow Along</p>
        <h2>See the chapter in motion</h2>
        <p>Event recaps, reels, and announcements land on Instagram first. Professional updates, sponsor news, and alumni features live on LinkedIn.</p>
        <div class="social-actions">
          <a href={SOCIALS.instagram} target="_blank" rel="noopener" class="btn btn-dark-outline">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r="1"/></svg>
            Instagram
          </a>
          <a href={SOCIALS.linkedin} target="_blank" rel="noopener" class="btn btn-dark-outline">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d={ICON_PATHS.linkedin}/></svg>
            LinkedIn
          </a>
          <a href={SOCIALS.tiktok} target="_blank" rel="noopener" class="btn btn-dark-outline">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d={ICON_PATHS.tiktok}/></svg>
            TikTok
          </a>
          {SOCIALS.discord && (
            <a href={SOCIALS.discord} target="_blank" rel="noopener" class="btn btn-dark-outline">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d={ICON_PATHS.discord}/></svg>
              Discord
            </a>
          )}
        </div>
      </div>
      <div class="ig-tiles">
        {socialTiles.map((t) => (
          <a class="ig-tile" href={t.data.link} target="_blank" rel="noopener" aria-label={t.data.caption}>
            <img src={t.data.thumbnail} alt={t.data.caption} loading="lazy">
            <span class="ig-play"><span><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span></span>
            <span class="ig-badge">
              {t.data.platform === 'tiktok'
                ? <svg viewBox="0 0 24 24" fill="currentColor"><path d={ICON_PATHS.tiktok}/></svg>
                : <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r="1"/></svg>}
            </span>
            <span class="ig-caption">{t.data.caption}</span>
          </a>
        ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
