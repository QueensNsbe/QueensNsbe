---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { ARROW } from '../components/icons';
import { SOCIALS, ICON_PATHS } from '../socials';

const execAll = await getCollection('exec');
const testimonials = (await getCollection('testimonials')).sort(
  (a, b) => a.data.order - b.data.order
);

const allEvents = (await getCollection('events')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const now = new Date();
const upcoming = allEvents.filter((e) => e.data.date >= now).reverse();
const featured = upcoming.length > 0 ? upcoming.slice(0, 3) : allEvents.slice(0, 3);
const eventsHeading = upcoming.length > 0 ? 'Upcoming Events' : 'Recent Events';

const JOIN_URL = '/join';
const IG_URL = SOCIALS.instagram;

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

const stats = [
  { count: 16000, suffix: '+', label: 'Members Worldwide', icon: 'people' },
  { count: 500, suffix: '+', label: 'Chapters Globally', icon: 'globe' },
  { count: 1975, suffix: '', label: 'NSBE Founded (Est.)', icon: 'star' },
  { count: execAll.length, suffix: '', label: "Queen's Exec Leaders", icon: 'cap' },
];

// Managed in the CMS under "Social Videos" so exec can swap in recent posts.
const socialTiles = (await getCollection('socialPosts')).sort(
  (a, b) => a.data.order - b.data.order
);

const ICONS: Record<string, string> = {
  people: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  globe: '<circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15 15 0 0 1 0 20a15 15 0 0 1 0-20z"/>',
  cap: '<path d="M22 10 12 5 2 10l10 5 10-5Z"/><path d="M6 12v5c0 1.5 3 3 6 3s6-1.5 6-3v-5"/>',
  briefcase: '<rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>',
};
const STAR = '<path d="M12 2l2.9 6.4L22 9l-5 5 1.2 7L12 17.8 5.8 21 7 14 2 9l7.1-.6z"/>';
---
<BaseLayout title="Home">
  <!-- ============ HERO ============ -->
  <header class="hero">
    <div class="hero-bg" style="background-image:url('/images/uploads/IMG_0441-scaled.jpg');"></div>
    <div class="hero-scrim"></div>
    <div class="container hero-content">
      <p class="kicker on-dark">Queen's University Chapter</p>
      <h1>Welcome to <em>NSBE Queen's</em></h1>
      <p class="lead">The National Society of Black Engineers, Queen's Chapter. We support academic success and celebrate Black excellence on campus through events, mentorship, and leadership opportunities.</p>
      <div class="hero-actions">
        <a href={JOIN_URL} class="btn btn-outline">Become a Member <Fragment set:html={ARROW} /></a>
      </div>
    </div>
  </header>

  <!-- ============ MARQUEE ============ -->
  <div class="marquee">
    <div class="marquee-track">
      <span>Excellence<span></span>Exposure<span></span>Community<span></span>Empathy<span></span>Leadership</span>
      <span>Excellence<span></span>Exposure<span></span>Community<span></span>Empathy<span></span>Leadership</span>
    </div>
  </div>

  <!-- ============ STATS ============ -->
  <section class="stats">
    <div class="container stats-grid">
      {stats.map((s) => (
        <div class="stat-tile reveal">
          <div class="stat-icon-badge">
            {s.icon === 'star'
              ? <svg viewBox="0 0 24 24" fill="currentColor" set:html={STAR} />
              : <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[s.icon]} />}
          </div>
          <div class="stat-num"><span data-count={s.count}>0</span>{s.suffix && <span class="suffix">{s.suffix}</span>}</div>
          <div class="stat-label">{s.label}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- ============ WHO WE ARE (+ member voices) ============ -->
  <section class="section">
    <div class="container split">
      <div class="split-body reveal">
        <p class="kicker">Who We Are</p>
        <h2>Building culturally responsible Black engineers.</h2>
        <p>The Queen's University National Society of Black Engineers (NSBE) chapter is one of the many chapters of the North American NSBE organization. Our mission is to increase the number of culturally responsible black engineers who excel academically, succeed professionally and positively impact the community.</p>
        <p>Through our events, mentorship, and leadership opportunities, we support academic success and celebrate Black excellence on campus.</p>
        <a href="/about" class="btn btn-purple">Learn More <Fragment set:html={ARROW} /></a>
      </div>
      <div class="split-media reveal">
        <img src="/images/uploads/IMG_9730-scaled.jpg" alt="NSBE Queen's members connecting at a chapter social" loading="lazy">
        <div class="frame-accent"></div>
      </div>
    </div>

    {testimonials.length > 0 && (
      <div class="container quote-strip reveal">
        <p class="quote-strip-head">In Their Words</p>
        <div class="quote-grid">
          {testimonials.slice(0, 3).map((t) => (
            <blockquote class="quote-card">
              <p class="quote">&ldquo;{t.data.quote}&rdquo;</p>
              <div class="attrib">
                {t.data.photo && <img src={t.data.photo} alt={t.data.name} loading="lazy">}
                <div>
                  <div class="name">{t.data.name}</div>
                  {t.data.role && <div class="role">{t.data.role}</div>}
                </div>
              </div>
            </blockquote>
          ))}
        </div>
      </div>
    )}
  </section>

  <!-- ============ MENTORSHIP TEASER ============ -->
  <section class="section">
    <div class="container split reverse">
      <div class="split-body reveal">
        <p class="kicker">Mentorship</p>
        <h2>Mentorship That Matters</h2>
        <p>Our mentorship program connects Black engineering students with upper-year students and graduates who understand their journey. Through guidance, support, and shared experiences, we help members navigate academic challenges, career opportunities, and personal growth.</p>
        <p>Mentorship at NSBE is about building lasting connections that inspire confidence, success, and a commitment to giving back.</p>
        <a href="/mentorship" class="btn btn-purple">Learn More <Fragment set:html={ARROW} /></a>
      </div>
      <div class="split-media reveal">
        <img src="/images/uploads/IMG_9834-1024x683.jpg" alt="NSBE Queen's mentorship program members" loading="lazy">
        <div class="frame-accent"></div>
      </div>
    </div>
  </section>

  <!-- ============ EVENTS TEASER ============ -->
  <section class="section">
    <div class="container">
      <div class="section-head center">
        <p class="kicker" style="justify-content:center;">What's Happening</p>
        <h2>{eventsHeading}</h2>
        <p>From study labs and career panels to socials and conferences, these are spaces to connect, learn, and celebrate Black excellence in STEM.</p>
      </div>
      {featured.length === 0 && <p class="text-center">No events yet. Check back soon.</p>}
      <div class="event-grid reveal-stagger">
        {featured.map((e) => (
          <a class={`event-card event-card--${e.data.category}`} href={`/events/${e.id}`}>
            {e.data.image && <div class="event-img"><img src={e.data.image} alt={e.data.title} loading="lazy"></div>}
            <div class="event-body">
              <div class="event-date">
                {fmtDate(e.data.date)}
                {e.data.category === 'mentorship' && <span class="event-tag event-tag--mentorship">Mentorship</span>}
              </div>
              <h3>{e.data.title}</h3>
              {e.data.location && <p>{e.data.location}</p>}
            </div>
          </a>
        ))}
      </div>
      <div class="text-center reveal" style="margin-top:40px;">
        <a href="/events" class="btn btn-dark-outline">View All Events <Fragment set:html={ARROW} /></a>
      </div>

      <div class="social-strip reveal chapter-motion">
      <div>
        <p class="kicker">Follow Along</p>
        <h2>See the chapter in motion</h2>
        <p>Event recaps, reels, and announcements land on Instagram first. Professional updates, sponsor news, and alumni features live on LinkedIn.</p>
        <div class="social-actions">
          <a href={SOCIALS.instagram} target="_blank" rel="noopener" class="btn btn-dark-outline">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r="1"/></svg>
            Instagram
          </a>
          <a href={SOCIALS.linkedin} target="_blank" rel="noopener" class="btn btn-dark-outline">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d={ICON_PATHS.linkedin}/></svg>
            LinkedIn
          </a>
          <a href={SOCIALS.tiktok} target="_blank" rel="noopener" class="btn btn-dark-outline">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d={ICON_PATHS.tiktok}/></svg>
            TikTok
          </a>
          {SOCIALS.discord && (
            <a href={SOCIALS.discord} target="_blank" rel="noopener" class="btn btn-dark-outline">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d={ICON_PATHS.discord}/></svg>
              Discord
            </a>
          )}
        </div>
      </div>
      <div class="ig-tiles">
        {socialTiles.map((t) => (
          <a class="ig-tile" href={t.data.link} target="_blank" rel="noopener" aria-label={t.data.caption}>
            <img src={t.data.thumbnail} alt={t.data.caption} loading="lazy">
            <span class="ig-play"><span><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span></span>
            <span class="ig-badge">
              {t.data.platform === 'tiktok'
                ? <svg viewBox="0 0 24 24" fill="currentColor"><path d={ICON_PATHS.tiktok}/></svg>
                : <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r="1"/></svg>}
            </span>
            <span class="ig-caption">{t.data.caption}</span>
          </a>
        ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
