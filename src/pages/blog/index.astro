---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---
<BaseLayout title="Blog" description="Announcements and updates from NSBE Queen's University.">
  <header class="page-hero">
    <div class="page-hero-bg" style="background-image:url('/images/uploads/IMG_9721-1024x683.jpg');"></div>
    <div class="page-hero-scrim"></div>
    <div class="container page-hero-content">
      <div class="breadcrumb"><a href="/">Home</a><span>/</span>Blog</div>
      <h1>News &amp; Announcements</h1>
      <p>Updates from the chapter — recaps, opportunities, and what's coming next.</p>
    </div>
  </header>

  <section class="section">
    <div class="container">
      {posts.length === 0 && <p class="text-center">No posts yet — check back soon.</p>}
      <div class="event-grid reveal-stagger">
        {posts.map((post) => (
          <a class="event-card" href={`/blog/${post.id}`}>
            {post.data.image && <div class="event-img"><img src={post.data.image} alt={post.data.title} loading="lazy"></div>}
            <div class="event-body">
              <div class="event-date">{fmtDate(post.data.date)}</div>
              <h3>{post.data.title}</h3>
              {post.data.excerpt && <p>{post.data.excerpt}</p>}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
