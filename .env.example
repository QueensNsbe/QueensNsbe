# Postgres connection string. Locally: postgres://<you>@127.0.0.1:5432/nsbe
# In production: the Neon connection string (Vercel → Settings → Environment Variables).
DATABASE_URL=
# Password for downloading the email list at /admin/subscribers.csv
ADMIN_PASSWORD=
# Any long random string; used to hash IPs for rate limiting
IP_HASH_SALT=
# Loops API key (Loops → Settings → API). Optional: without it, signups are only saved to the database.
LOOPS_API_KEY=
